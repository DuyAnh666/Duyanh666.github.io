{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".git/**",
      ".gitignore",
      "node_modules/**",
      "Trắc nghiệm các nhóm/**",
      "ai-worker/**",
      "**/*.docx",
      "**/*.pdf",
      "**/*.py"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|png|jpg|jpeg|svg)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      }
    ]
  }
}

